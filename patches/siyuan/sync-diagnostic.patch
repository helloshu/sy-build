+			logging.LogWarnf("[sync-diag] performSync skipped [reason=mobile-switch-gate, userRequired=%t, userPresent=%t, enabled=%t, provider=%d]", userRequired, nil != model.Conf.GetUser(), model.Conf.Sync.Enabled, model.Conf.Sync.Provider)
 			return
 		}
 	}
 
 	if 3 != model.Conf.Sync.Mode {
+		logging.LogInfof("[sync-diag] performSync dispatch [mode=%d, mobileSwitch=%t, direction=automatic]", model.Conf.Sync.Mode, mobileSwitch)
 		model.SyncData(true)
+		logging.LogInfof("[sync-diag] performSync returned [direction=automatic]")
 		return
 	}
 
 	// 云端同步模式支持 `完全手动同步` 模式 https://github.com/siyuan-note/siyuan/issues/7295
 	upload, err := request.UploadDirection()
 	if err != nil {
+		logging.LogWarnf("[sync-diag] performSync skipped [reason=invalid-upload]")
 		return apicontract.Failure[apicontract.Null](-1, err.Error())
 	}
+	logging.LogInfof("[sync-diag] performSync dispatch [mode=%d, mobileSwitch=%t, upload=%t]", model.Conf.Sync.Mode, mobileSwitch, upload)
 	if upload {
 		model.SyncDataUpload()
 	} else {
 		model.SyncDataDownload()
 	}
+	logging.LogInfof("[sync-diag] performSync returned [upload=%t]", upload)
 	return
 }
 
