+// syncModeGateLogged 避免自动同步周期内重复记录同一同步模式拦截。
+var syncModeGateLogged atomic.Bool
+
+func syncProviderEndpointPresent() bool {
+	confSyncReadSnapshot := Conf.LoadSync()
+
+	switch confSyncReadSnapshot.Provider {
+	case conf.ProviderSiYuan:
+		return "" != strings.TrimSpace(util.GetCloudSyncServer())
+	case conf.ProviderS3:
+		return nil != confSyncReadSnapshot.S3 && "" != strings.TrimSpace(confSyncReadSnapshot.S3.Endpoint)
+	case conf.ProviderWebDAV:
+		return nil != confSyncReadSnapshot.WebDAV && "" != strings.TrimSpace(confSyncReadSnapshot.WebDAV.Endpoint)
+	case conf.ProviderLocal:
+		return nil != confSyncReadSnapshot.Local && "" != strings.TrimSpace(confSyncReadSnapshot.Local.Endpoint)
+	}
+	return false
+}
